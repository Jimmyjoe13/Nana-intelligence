<IfModule mod_rewrite.c>
RewriteEngine On
# slash final unique -> version avec slash
RewriteCond %{REQUEST_URI} ^/([^.]+[^/])$
RewriteRule ^(.*)$ /$1/ [R=301,L]
Redirect 301 /blog/1 /blog/agence-prospection-b2b-ou-commercial-interne/
Redirect 301 /blog/1/ /blog/agence-prospection-b2b-ou-commercial-interne/
